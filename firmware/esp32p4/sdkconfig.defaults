# FireBeetle 2 ESP32-P4 (DFR1172): 16 MB flash, 32 MB PSRAM
CONFIG_IDF_TARGET="esp32p4"
# FireBeetle 2 boards ship with early P4 silicon (v1.x); builds for v3.x chips do not boot on them.
# A board with a v3 chip needs these two lines removed.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Code runs from flash through the caches: quad I/O at 80 MHz instead of the default dual I/O at
# 40 MHz makes each cache miss (Opus, while the mic decodes on the other core) about 4x faster.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y

# Wi-Fi comes from the on-board ESP32-C6 through ESP-Hosted
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
# FireBeetle wiki pin table: D0..D3 = GPIO14..17, CLK = GPIO18, CMD = GPIO19, C6 EN = GPIO54
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54

# The controller only reaches the board, never the internet: answer DNS ourselves
CONFIG_LWIP_DHCPS=y
CONFIG_LWIP_MAX_SOCKETS=16

# ESP-Hosted recommends a 1 ms tick
CONFIG_FREERTOS_HZ=1000

# Step 2b: DTLS-SRTP display link
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
# TLS/DTLS buffers in PSRAM: they are only busy during connection setup, and internal RAM is
# the scarce one (USB, SDIO, task stacks, the audio path).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
